# Application Environment
APP_ENV=development
APP_NAME="AI Recruitment & Resume Intelligence Platform"
PORT=8000
DEBUG=true

# Security & Authenticated Field Encryption
# Base64-encoded 32-byte key for AES-GCM / Fernet personal data encryption
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS0zMmJ5dGUtZW5jcnlwdGlvbi1rZXk=
SECRET_KEY=change-this-in-production-secure-app-secret-key-32chars
TOKEN_EXPIRE_MINUTES=480

# Database Configuration
DATABASE_URL=sqlite:///./storage/db/recruitment.db

# DMS (Document Management System) Storage
DMS_STORAGE_DIR=./storage/dms
MAX_UPLOAD_SIZE_MB=15
ALLOWED_FILE_TYPES=pdf,docx

# IKM (Intelligent Knowledge Management) / RAG Builder Integration
# Per company infrastructure: IKM is our internal DMS platform engine & RAG builder.
# Provides scraping, template extraction, Neo4j graph storage, and hybrid retrieval.
IKM_ENABLED=true
RAG_BUILDER_BASE_URL=http://16.113.145.53:8088
RAG_BUILDER_USERNAME=resume-screening
RAG_BUILDER_PASSWORD=your-rag-builder-password
IKM_REPOSITORY_ID=
IKM_TIMEOUT_SECONDS=12.0

# Neo4j Graph Database (Optional)
# If empty or unreachable, platform safely falls back to resilient in-memory graph repository
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=recruitment_neo4j_password

# LLM & Reasoning Service
LLM_PROVIDER=grok  # 'grok', 'heuristic', 'gemini', or 'openai'
GROK_API_KEY=xai-your-grok-api-key-here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
GEMINI_API_KEY=
OPENAI_API_KEY=

# Recruitment Workflow Policy Defaults
DEFAULT_MAX_SHORTLIST=50
DEFAULT_INACTIVITY_THRESHOLD_DAYS=7
DUPLICATE_FILE_POLICY=version  # 'reject', 'link', or 'version'

# SMTP Live Email Delivery (Google / Gmail / Google Workspace)
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="HR Recruitment Console"

